from pathlib import Path

from .loader import load_document
from .splitter import split_documents
from .vectorstore import create_vectorstore


def ingest_document(file_path: str):
    """
    Load, normalize, split, and index a document in ChromaDB.

    The document_id is generated by the loader so that the same
    file receives a consistent ID across the pipeline.
    """

    path = Path(file_path).expanduser()

    print(f"\nLoading document: {path}")

    # 1. Validate the input path.
    if not path.exists():
        raise FileNotFoundError(
            f"Document not found: {path}"
        )

    if not path.is_file():
        raise ValueError(
            f"Expected a file, but received: {path}"
        )

    # 2. Load the document.
    documents = load_document(str(path))

    if not documents:
        raise ValueError(
            f"No readable documents were loaded from {path.name}"
        )

    print(f"Documents loaded: {len(documents)}")

    # 3. Ensure consistent source metadata.
    for document in documents:
        metadata = document.metadata

        metadata["source"] = path.name
        metadata["filename"] = path.name
        metadata["file_type"] = path.suffix.lower().lstrip(".")

        if "document_id" not in metadata:
            raise ValueError(
                "Loader did not assign document_id metadata."
            )

        if "page" not in metadata:
            metadata["page"] = None

    # 4. Split the loaded documents.
    chunks = split_documents(documents)

    if not chunks:
        raise ValueError(
            f"No chunks were created from {path.name}"
        )

    print(f"Chunks created: {len(chunks)}")

    # 5. Assign chunk metadata while preserving source and page.
    for index, chunk in enumerate(chunks):
        metadata = chunk.metadata

        metadata["source"] = path.name
        metadata["filename"] = path.name
        metadata["file_type"] = path.suffix.lower().lstrip(".")
        metadata["chunk_id"] = index

        if "document_id" not in metadata:
            raise ValueError(
                f"Chunk {index} is missing document_id metadata."
            )

        if "page" not in metadata:
            metadata["page"] = None

    # 6. Index chunks using the existing vectorstore pipeline.
    create_vectorstore(chunks)

    print(f"Document successfully indexed: {path.name}")
    print(f"Total chunks submitted: {len(chunks)}")

    return len(chunks)
